@model IEnumerable<UserDataModel>

@{
    ViewData["Title"] = "User Management";
}

@functions {
    string Ago(DateTime time)
    {
        var diff = DateTime.UtcNow - time;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return (int)diff.TotalMinutes + " minutes ago";
        if (diff.TotalHours < 24) return (int)diff.TotalHours + " hours ago";
        return (int)diff.TotalDays + " days ago";
    }
}

<h3>User Management</h3>

<form id="users-form" method="post">
    <div class="mb-3 d-flex gap-2">
        <button type="submit" asp-action="UserBlock" class="btn btn-primary btn-sm" title="Block selected users">Block</button>
        <button type="submit" asp-action="UserUnblock" class="btn btn-outline-secondary btn-sm" title="Unblock selected users"><i class="bi bi-unlock"></i></button>
        <button type="submit" asp-action="UserDelete" class="btn btn-outline-secondary btn-sm" title="Delete selected users"><i class="bi bi-trash3"></i></button>
        <button type="submit" asp-action="DeleteUnverified" class="btn btn-outline-secondary btn-sm" title="Delete unverified users"><i class="bi bi-person-slash"></i></button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover table-sm align-middle">
            <thead>
                <tr>
                    <th style="width: 36px;" class="text-center">
                        <input class="form-check-input" type="checkbox" id="select-all" title="Select all" />
                    </th>
                    <th>Name</th>
                    <th>E-mail</th>
                    <th>Last login</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <input class="form-check-input user-checkbox" type="checkbox" name="selectedIds" value="@user.Id" />
                            </td>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@Ago(user.LastRegisterTime)</td>
                            <td>
                                @if (user.IsBlocked)
                                {
                                    <span>Blocked</span>
                                }
                                else if (user.EmailConfirmedStatus)
                                {
                                    <span>Active</span>
                                }
                                else
                                {
                                    <span>Unverified</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No users found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</form>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script>
        var selectAllBox = document.getElementById('select-all');
        var userBoxes = document.querySelectorAll('.user-checkbox');

        selectAllBox.addEventListener('change', function () {
            userBoxes.forEach(function (box) { box.checked = selectAllBox.checked; });
        });
    </script>
}
